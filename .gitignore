# ---------------------------
# Python cache / bytecode
# ---------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ---------------------------
# Pytest cache
# ---------------------------
.pytest_cache/

# ---------------------------
# Desktop app runtime output
# ---------------------------
logs/
alexis_config.json

# ---------------------------
# Security zone identifier (Windows)
# ---------------------------
*:Zone.Identifier
*Zone.Identifier

# ---------------------------
# Virtual environments
# ---------------------------
.venv/
.venv-win/
venv/
env/

# ---------------------------
# Claude Code agent worktrees (never commit these)
# ---------------------------
.claude/worktrees/
.claude/launch.json

# ---------------------------
# Data files (large, regenerable)
# ---------------------------
storage/snapshots/
storage/changelogs/
storage/instructions/
storage/checkpoints/
storage/audits/
storage/raw/
storage/mesh/
storage/unassigned_650.json
*.json.bak

# ---------------------------
# One-off diagnostic scripts / outputs
# ---------------------------
diagnose_modality.py
modality_diagnosis.csv
modality_fix_report.py
no_id_mesh_terms.txt

# ---------------------------
# Backup files
# ---------------------------
*_backup.py
*backup*.py

# ---------------------------
# Large data / model binaries
# (raw exports, checkpoints, derived parquet/csv, classifier pickles)
# ---------------------------
classifiers/*.pkl
storage/*.xml
storage/*.parquet
storage/*.zip
storage/*.jsonl
storage/*.csv
storage/TrialDetails*/

# Data / generated output that must not be tracked (intl changelogs, caches, xlsx)
storage/cache/
storage/anzctr_changelogs/
storage/chictr_changelogs/
storage/*.xlsx

# Claude Code personal/local settings (per-machine; keep on disk, out of git)
.claude/settings.local.json
